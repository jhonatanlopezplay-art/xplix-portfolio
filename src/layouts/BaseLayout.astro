---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Xplix | Dev Portfolio', description = 'Mod developer & programmer' } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/perfil.png" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
