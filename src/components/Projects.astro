---
const mods = [
  {
    id: "minesweeper",
    name: "Buscaminas",
    type: "Fabric Mod",
    desc: "Minijuego de buscaminas donde la memoria juega un papel clave para no quedar eliminado. Inspirado en Squid Craft Games 4, totalmente competitivo.",
    tags: ["fabric", "minigame", "competitive"],
    icon: "",
    color: "#67e8f9",
    status: "released",
  },
  {
    id: "agrupados",
    name: "Agrupados",
    type: "Fabric Mod",
    desc: "Minijuego de grupos donde los jugadores deben agruparse antes que las salas se agoten. Muy estresante, especialmente al momento de jugarlo en vivo.",
    tags: ["fabric", "teams", "stress"],
    icon: "",
    color: "#fbbf24",
    status: "released",
  },
  {
    id: "periquito",
    name: "Periquito",
    type: "Fabric Mod",
    desc: "El famoso juego del periquito — la memoria lo hace tedioso de la mejor forma. Inspirado en los eventos de Eufonia Studio.",
    tags: ["fabric", "memory", "eufonia"],
    icon: "",
    color: "#34d399",
    status: "released",
  },
  {
    id: "galleta",
    name: "Galleta",
    type: "Fabric Mod",
    desc: "Un clásico que tenía que estar. Fue mi segundo proyecto y donde más avancé como desarrollador de mods — cada línea fue una lección.",
    tags: ["fabric", "classic", "challenge"],
    icon: "",
    color: "#a78bfa",
    status: "released",
  },
];

const launcherFeatures = [
  {
    id: "instances",
    label: "instancias",
    title: "Acceso por Código",
    desc: "Las instancias del servidor están protegidas por código. Solo los jugadores autorizados pueden unirse — control total para el estudio.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>`,
    color: "#67e8f9",
    imgIndex: 1,
  },
  {
    id: "skins",
    label: "skins",
    title: "Gestión de Skins",
    desc: "Integración con Ely.by para subir, importar y previsualizar tu skin directamente desde el cliente. Sin abrir el navegador.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>`,
    color: "#a78bfa",
    imgIndex: 2,
  },
  {
    id: "social",
    label: "social",
    title: "Amigos & Chat",
    desc: "Sistema de amigos con estado en línea y chat directo integrado. Sin salir del cliente, sin emojis — solo texto limpio.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    color: "#34d399",
    imgIndex: 3,
  },
];

// Images: index 0 = home screen, 1 = instances, 2 = skins, 3 = friends list, 4 = chat
const launcherScreenshots = [
  { src: "/launcher/home.png",      alt: "Lebiu Client — Pantalla principal" },
  { src: "/launcher/instances.png", alt: "Lebiu Client — Instancias con código de acceso" },
  { src: "/launcher/skins.png",     alt: "Lebiu Client — Gestión de skins con Ely.by" },
  { src: "/launcher/friends.png",   alt: "Lebiu Client — Lista de amigos en línea" },
  { src: "/launcher/chat.png",      alt: "Lebiu Client — Chat directo entre jugadores" },
];
---

<section id="projects" class="projects-section">
  <div class="container">

    <div class="reveal">
      <p class="section-badge mono-font">02 / projects</p>
      <h2 class="section-title pixel-font">mis_mods</h2>
      <div class="section-divider"></div>
    </div>

    <div class="project-sub-label reveal">
      <span class="mono-font">fabric_mods/</span>
      <span class="sub-desc mono-font">— Squid Craft Games 4 inspired</span>
    </div>

    <div class="mods-grid">
      {mods.map((mod) => (
        <div class="mod-card lg-card reveal" style={`--card-color: ${mod.color}`}>
          <div class="card-top-line"></div>
          <div class="card-header">
            <span class="card-icon">{mod.icon}</span>
            <span class={`card-status mono-font ${mod.status === 'released' ? 'status-live' : 'status-wip'}`}>
              {mod.status === 'released' ? '● LIVE' : '◌ WIP'}
            </span>
          </div>
          <p class="card-type mono-font">{mod.type}</p>
          <h3 class="card-name pixel-font">{mod.name}</h3>
          <p class="card-desc">{mod.desc}</p>
          <div class="card-tags">
            {mod.tags.map(tag => (
              <span class="card-tag mono-font">#{tag}</span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- ══════════════════════════════════════════ -->
    <!-- LEBIU CLIENT SHOWCASE                       -->
    <!-- ══════════════════════════════════════════ -->
    <div class="lc-showcase reveal">

      <!-- Header row -->
      <div class="lc-header">
        <div class="lc-header-left">
          <div class="lc-eyebrow mono-font">
            <span class="lc-type-label">CLIENTE DE MINECRAFT</span>
            <span class="lc-badge-live mono-font">● LISTO</span>
          </div>
          <h3 class="lc-title pixel-font">Lebiu<span class="lc-accent">_</span>Client</h3>
          <p class="lc-subtitle">
            El cliente oficial de Lebiu Studio — acceso exclusivo, identidad propia y comunidad integrada.
            Construido desde cero para que cada sesión se sienta tuya.
          </p>
          <div class="lc-tags">
            {["launcher", "java", "desktop", "community", "fabric"].map(t => (
              <span class="lc-tag mono-font">#{t}</span>
            ))}
          </div>
        </div>
        <div class="lc-koala-badge">
          <div class="lc-hex-ring">
            <div class="lc-hex-inner">🐨</div>
          </div>
        </div>
      </div>

      <!-- Hero screenshot (home screen) -->
      <div class="lc-hero-shot">
        <div class="lc-screen-frame">
          <div class="lc-frame-bar">
            <div class="lc-dots">
              <span class="dot dot-r"></span>
              <span class="dot dot-y"></span>
              <span class="dot dot-g"></span>
            </div>
            <span class="lc-frame-title mono-font">Lebiu Client — v1.0</span>
          </div>
          <div class="lc-screen-img-wrap">
            <img
              src={launcherScreenshots[0].src}
              alt={launcherScreenshots[0].alt}
              class="lc-screen-img"
              loading="lazy"
            />
            <div class="lc-screen-overlay"></div>
          </div>
        </div>
        <div class="lc-screen-glow"></div>
      </div>

      <!-- Feature tabs -->
      <div class="lc-features">
        <div class="lc-tabs" role="tablist" id="lc-tablist">
          {launcherFeatures.map((f, i) => (
            <button
              class={`lc-tab mono-font ${i === 0 ? 'active' : ''}`}
              data-tab={f.id}
              data-img={f.imgIndex}
              role="tab"
              style={`--tab-color: ${f.color}`}
            >
              <span class="lc-tab-icon" set:html={f.icon} />
              {f.label}
            </button>
          ))}
        </div>

        <div class="lc-feature-body">
          {launcherFeatures.map((f, i) => (
            <div
              class={`lc-feature-panel ${i === 0 ? 'active' : ''}`}
              data-panel={f.id}
              style={`--panel-color: ${f.color}`}
            >
              <div class="lc-panel-info">
                <div class="lc-panel-icon" set:html={f.icon} />
                <div>
                  <p class="lc-panel-label mono-font">{f.label}/</p>
                  <h4 class="lc-panel-title pixel-font">{f.title}</h4>
                  <p class="lc-panel-desc">{f.desc}</p>
                </div>
              </div>
              <div class="lc-panel-shot">
                <img
                  src={launcherScreenshots[f.imgIndex].src}
                  alt={launcherScreenshots[f.imgIndex].alt}
                  class="lc-panel-img"
                  loading="lazy"
                />
                <div class="lc-panel-glow"></div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Bottom strip: social preview (friends + chat side by side) -->
      <div class="lc-social-strip">
        <div class="lc-social-label mono-font">// social_system</div>
        <div class="lc-social-frames">
          <div class="lc-social-frame">
            <img
              src={launcherScreenshots[3].src}
              alt={launcherScreenshots[3].alt}
              class="lc-social-img"
              loading="lazy"
            />
            <span class="lc-social-cap mono-font">amigos_en_linea</span>
          </div>
          <div class="lc-social-frame">
            <img
              src={launcherScreenshots[4].src}
              alt={launcherScreenshots[4].alt}
              class="lc-social-img"
              loading="lazy"
            />
            <span class="lc-social-cap mono-font">chat_directo</span>
          </div>
        </div>
      </div>

    </div>
    <!-- / lc-showcase -->

    <div class="more-soon lg-card reveal">
      <span class="more-cursor">▮</span>
      <span class="mono-font"> más proyectos en camino...</span>
    </div>

  </div>
</section>

<style>
  .projects-section { padding: 6rem 0; position: relative; z-index: 1; }

  .project-sub-label {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    font-size: 0.75rem;
    color: var(--muted);
    letter-spacing: 1px;
  }
  .project-sub-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: rgba(255, 255, 255, 0.08);
    max-width: 200px;
  }
  .sub-desc { color: var(--muted); margin-left: 4px; }

  /* grid */
  .mods-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
    margin-bottom: 1rem;
  }

  /* mod card */
  .mod-card {
    padding: 1.75rem;
    cursor: default;
    transition: transform 0.25s, box-shadow 0.25s;
  }
  .mod-card:hover { transform: translateY(-6px); }

  .card-top-line {
    position: absolute;
    top: 0; left: 0; right: 0; height: 2px;
    background: var(--card-color, var(--cyan));
    opacity: 0; transition: opacity 0.2s;
    box-shadow: 0 0 16px var(--card-color, var(--cyan));
  }
  .mod-card:hover .card-top-line { opacity: 1; }

  .card-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.25rem; }
  .card-icon { font-size: 2rem; line-height: 1; }
  .card-status { font-size: 0.6rem; padding: 3px 8px; letter-spacing: 1px; }
  .status-live {
    color: var(--green);
    border: 1px solid rgba(52, 211, 153, 0.35);
    background: rgba(52, 211, 153, 0.08);
    text-shadow: 0 0 8px var(--green);
  }
  .status-wip {
    color: var(--amber);
    border: 1px solid rgba(251, 191, 36, 0.35);
    background: rgba(251, 191, 36, 0.08);
  }
  .card-type { font-size: 0.65rem; color: var(--muted); margin-bottom: 0.5rem; letter-spacing: 1px; }
  .card-name { font-size: 0.75rem; color: var(--white); margin-bottom: 1rem; line-height: 1.6; }
  .card-desc { font-size: 0.87rem; color: rgba(224, 242, 254, 0.65); line-height: 1.7; margin-bottom: 1.25rem; }
  .card-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .card-tag { font-size: 0.6rem; color: var(--muted2); padding: 2px 8px; }

  /* ══════════════════════════════════════════ */
  /* LEBIU CLIENT SHOWCASE                       */
  /* ══════════════════════════════════════════ */
  .lc-showcase {
    margin-top: 4rem;
    background: linear-gradient(135deg,
      rgba(14, 20, 32, 0.95) 0%,
      rgba(8, 14, 24, 0.98) 100%
    );
    border: 1px solid rgba(103, 232, 249, 0.12);
    border-radius: 2px;
    overflow: hidden;
    position: relative;
  }
  .lc-showcase::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; height: 2px;
    background: linear-gradient(90deg, transparent, var(--cyan), var(--blue2), transparent);
    box-shadow: 0 0 30px rgba(34, 211, 238, 0.6);
  }

  /* Header */
  .lc-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    padding: 2.5rem 2.5rem 0;
  }
  .lc-header-left { flex: 1; }

  .lc-eyebrow {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .lc-type-label {
    font-size: 0.6rem;
    color: var(--muted);
    letter-spacing: 2px;
  }
  .lc-badge-live {
    font-size: 0.58rem;
    color: var(--green);
    border: 1px solid rgba(52, 211, 153, 0.4);
    background: rgba(52, 211, 153, 0.08);
    padding: 3px 10px;
    letter-spacing: 1px;
    text-shadow: 0 0 10px var(--green);
    animation: pulse-glow 2s ease-in-out infinite;
  }
  @keyframes pulse-glow {
    0%, 100% { box-shadow: 0 0 6px rgba(52, 211, 153, 0.2); }
    50% { box-shadow: 0 0 14px rgba(52, 211, 153, 0.5); }
  }

  .lc-title {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    color: var(--white);
    margin-bottom: 0.75rem;
    line-height: 1.3;
    text-shadow: 0 0 40px rgba(103, 232, 249, 0.3);
  }
  .lc-accent {
    color: var(--cyan);
    text-shadow: 0 0 20px rgba(34, 211, 238, 0.8);
    animation: blink 1.2s step-end infinite;
  }

  .lc-subtitle {
    font-size: 0.92rem;
    color: rgba(224, 242, 254, 0.6);
    line-height: 1.8;
    max-width: 520px;
    margin-bottom: 1.25rem;
  }

  .lc-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .lc-tag {
    font-size: 0.58rem;
    color: var(--cyan2);
    border: 1px solid rgba(103, 232, 249, 0.15);
    background: rgba(103, 232, 249, 0.04);
    padding: 3px 10px;
    letter-spacing: 0.5px;
  }

  /* Koala hex badge */
  .lc-koala-badge {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lc-hex-ring {
    width: 90px; height: 90px;
    display: flex; align-items: center; justify-content: center;
    position: relative;
    background: rgba(34, 211, 238, 0.04);
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    border: 1px solid rgba(34, 211, 238, 0.2);
    animation: hex-pulse 4s ease-in-out infinite;
  }
  @keyframes hex-pulse {
    0%, 100% { filter: drop-shadow(0 0 8px rgba(34, 211, 238, 0.2)); }
    50% { filter: drop-shadow(0 0 20px rgba(34, 211, 238, 0.5)); }
  }
  .lc-hex-inner { font-size: 2.4rem; }

  /* Hero screenshot */
  .lc-hero-shot {
    position: relative;
    padding: 2rem 2.5rem;
  }
  .lc-screen-frame {
    border: 1px solid rgba(103, 232, 249, 0.15);
    background: #0a0d14;
    overflow: hidden;
    position: relative;
  }
  .lc-frame-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 8px 14px;
    background: rgba(255,255,255,0.03);
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .lc-dots { display: flex; gap: 6px; }
  .dot { width: 10px; height: 10px; border-radius: 50%; }
  .dot-r { background: #ff5f57; }
  .dot-y { background: #febc2e; }
  .dot-g { background: #28c840; }
  .lc-frame-title {
    font-size: 0.6rem;
    color: var(--muted);
    letter-spacing: 1px;
    margin: 0 auto;
  }
  .lc-screen-img-wrap { position: relative; }
  .lc-screen-img {
    width: 100%;
    display: block;
    max-height: 420px;
    object-fit: cover;
    object-position: top;
    transition: transform 0.6s ease;
  }
  .lc-screen-img:hover { transform: scale(1.01); }
  .lc-screen-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to bottom, transparent 60%, rgba(8, 14, 24, 0.7) 100%);
    pointer-events: none;
  }
  .lc-screen-glow {
    position: absolute;
    bottom: 1.5rem; left: 50%; transform: translateX(-50%);
    width: 60%; height: 60px;
    background: radial-gradient(ellipse, rgba(34, 211, 238, 0.12), transparent 70%);
    pointer-events: none;
    filter: blur(20px);
  }

  /* Feature tabs */
  .lc-features {
    padding: 0 2.5rem 2rem;
  }
  .lc-tabs {
    display: flex;
    gap: 0;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    margin-bottom: 0;
  }
  .lc-tab {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    font-size: 0.65rem;
    color: var(--muted);
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    letter-spacing: 1px;
    transition: color 0.2s, border-color 0.2s;
    margin-bottom: -1px;
  }
  .lc-tab .lc-tab-icon { opacity: 0.5; transition: opacity 0.2s; }
  .lc-tab:hover { color: rgba(224, 242, 254, 0.7); }
  .lc-tab.active {
    color: var(--tab-color, var(--cyan));
    border-bottom-color: var(--tab-color, var(--cyan));
  }
  .lc-tab.active .lc-tab-icon { opacity: 1; }

  /* Feature panels */
  .lc-feature-panel {
    display: none;
    gap: 2rem;
    padding: 1.75rem 0 0;
    grid-template-columns: 1fr 1.5fr;
    align-items: center;
  }
  .lc-feature-panel.active {
    display: grid;
    animation: fade-panel 0.3s ease;
  }
  @keyframes fade-panel {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .lc-panel-info {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .lc-panel-icon {
    width: 44px; height: 44px;
    display: flex; align-items: center; justify-content: center;
    color: var(--panel-color, var(--cyan));
    border: 1px solid color-mix(in srgb, var(--panel-color, var(--cyan)) 30%, transparent);
    background: color-mix(in srgb, var(--panel-color, var(--cyan)) 6%, transparent);
  }
  .lc-panel-label {
    font-size: 0.6rem;
    color: var(--panel-color, var(--cyan));
    letter-spacing: 1.5px;
    margin-bottom: 0.25rem;
  }
  .lc-panel-title {
    font-size: 0.85rem;
    color: var(--white);
    line-height: 1.5;
    margin-bottom: 0.5rem;
  }
  .lc-panel-desc {
    font-size: 0.88rem;
    color: rgba(224, 242, 254, 0.6);
    line-height: 1.8;
  }

  .lc-panel-shot {
    position: relative;
  }
  .lc-panel-img {
    width: 100%;
    border: 1px solid rgba(255,255,255,0.08);
    display: block;
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }
  .lc-panel-img:hover {
    transform: scale(1.02);
    box-shadow: 0 8px 40px rgba(0,0,0,0.5);
  }
  .lc-panel-glow {
    position: absolute; bottom: -12px; left: 50%; transform: translateX(-50%);
    width: 70%; height: 40px;
    background: radial-gradient(ellipse, var(--panel-color, rgba(34,211,238,0.15)), transparent 70%);
    filter: blur(16px);
    pointer-events: none;
    opacity: 0.5;
  }

  /* Social strip */
  .lc-social-strip {
    border-top: 1px solid rgba(255,255,255,0.06);
    padding: 1.75rem 2.5rem 2rem;
    background: rgba(0,0,0,0.2);
  }
  .lc-social-label {
    font-size: 0.6rem;
    color: var(--muted);
    letter-spacing: 1.5px;
    margin-bottom: 1.25rem;
  }
  .lc-social-frames {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  .lc-social-frame {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .lc-social-img {
    width: 100%;
    border: 1px solid rgba(255,255,255,0.07);
    display: block;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }
  .lc-social-img:hover {
    transform: scale(1.015);
    border-color: rgba(103, 232, 249, 0.3);
  }
  .lc-social-cap {
    font-size: 0.58rem;
    color: var(--muted);
    letter-spacing: 1px;
  }

  /* more soon */
  .more-soon { margin-top: 3rem; padding: 2rem; text-align: center; font-size: 0.8rem; color: var(--muted); }
  .more-cursor { color: var(--cyan2); animation: blink 1s step-end infinite; text-shadow: 0 0 8px var(--cyan); }

  /* responsive */
  @media (max-width: 900px) {
    .lc-header { flex-direction: column; }
    .lc-koala-badge { display: none; }
    .lc-feature-panel.active { grid-template-columns: 1fr; }
    .lc-social-frames { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .lc-showcase { margin-top: 2.5rem; }
    .lc-header, .lc-hero-shot, .lc-features, .lc-social-strip { padding-left: 1.25rem; padding-right: 1.25rem; }
    .lc-tabs { overflow-x: auto; }
  }
</style>

<script>
  // Tab switching
  const tabs = document.querySelectorAll('.lc-tab');
  const panels = document.querySelectorAll('.lc-feature-panel');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const id = (tab as HTMLElement).dataset.tab;

      tabs.forEach(t => t.classList.remove('active'));
      panels.forEach(p => p.classList.remove('active'));

      tab.classList.add('active');
      document.querySelector(`[data-panel="${id}"]`)?.classList.add('active');
    });
  });
</script>
