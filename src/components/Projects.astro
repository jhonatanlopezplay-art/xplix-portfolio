---
const mods = [
  {
    id: "minesweeper",
    name: "Buscaminas",
    type: "Fabric Mod",
    desc: "Minijuego de buscaminas donde la memoria juega un papel clave para no quedar eliminado. Inspirado en Squid Craft Games 4, totalmente competitivo.",
    tags: ["fabric", "minigame", "competitive"],
    icon: "",
    color: "#67e8f9",
    status: "released",
  },
  {
    id: "agrupados",
    name: "Agrupados",
    type: "Fabric Mod",
    desc: "Minijuego de grupos donde los jugadores deben agruparse antes que las salas se agoten. Muy estresante, especialmente al momento de jugarlo en vivo.",
    tags: ["fabric", "teams", "stress"],
    icon: "",
    color: "#fbbf24",
    status: "released",
  },
  {
    id: "periquito",
    name: "Periquito",
    type: "Fabric Mod",
    desc: "El famoso juego del periquito — la memoria lo hace tedioso de la mejor forma. Inspirado en los eventos de Eufonia Studio.",
    tags: ["fabric", "memory", "eufonia"],
    icon: "",
    color: "#34d399",
    status: "released",
  },
  {
    id: "galleta",
    name: "Galleta",
    type: "Fabric Mod",
    desc: "Un clásico que tenía que estar. Fue mi segundo proyecto y donde más avancé como desarrollador de mods — cada línea fue una lección.",
    tags: ["fabric", "classic", "challenge"],
    icon: "",
    color: "#a78bfa",
    status: "released",
  },
];

const launcherFeatures = [
  {
    id: "instances",
    label: "instancias",
    title: "Acceso por Código",
    desc: "Las instancias del servidor están protegidas por código. Solo los jugadores autorizados pueden unirse — control total para el estudio.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>`,
    color: "#67e8f9",
    imgIndex: 1,
  },
  {
    id: "skins",
    label: "skins",
    title: "Gestión de Skins",
    desc: "Integración con Ely.by para subir, importar y previsualizar tu skin directamente desde el cliente. Sin abrir el navegador.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>`,
    color: "#a78bfa",
    imgIndex: 2,
  },
  {
    id: "social",
    label: "social",
    title: "Amigos & Chat",
    desc: "Sistema de amigos con estado en línea y chat directo integrado. Sin salir del cliente, sin emojis — solo texto limpio.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    color: "#34d399",
    imgIndex: 3,
  },
];

// Images: index 0 = home screen, 1 = instances, 2 = skins, 3 = friends list, 4 = chat
const launcherScreenshots = [
  { src: "/launcher/home.png",      alt: "Lebiu Client — Pantalla principal" },
  { src: "/launcher/instances.png", alt: "Lebiu Client — Instancias con código de acceso" },
  { src: "/launcher/skins.png",     alt: "Lebiu Client — Gestión de skins con Ely.by" },
  { src: "/launcher/friends.png",   alt: "Lebiu Client — Lista de amigos en línea" },
  { src: "/launcher/chat.png",      alt: "Lebiu Client — Chat directo entre jugadores" },
];
---

<section id="projects" class="projects-section">
  <div class="container">

    <div class="reveal">
      <p class="section-badge mono-font">02 / projects</p>
      <h2 class="section-title pixel-font">mis_mods</h2>
      <div class="section-divider"></div>
    </div>

    <div class="project-sub-label reveal">
      <span class="mono-font">fabric_mods/</span>
      <span class="sub-desc mono-font">— Squid Craft Games 4 inspired</span>
    </div>

    <div class="mods-grid">
      {mods.map((mod) => (
        <div class="mod-card lg-card reveal" style={`--card-color: ${mod.color}`}>
          <div class="card-top-line"></div>
          <div class="card-header">
            <span class="card-icon">{mod.icon}</span>
            <span class={`card-status mono-font ${mod.status === 'released' ? 'status-live' : 'status-wip'}`}>
              {mod.status === 'released' ? '● LIVE' : '◌ WIP'}
            </span>
          </div>
          <p class="card-type mono-font">{mod.type}</p>
          <h3 class="card-name pixel-font">{mod.name}</h3>
          <p class="card-desc">{mod.desc}</p>
          <div class="card-tags">
            {mod.tags.map(tag => (
              <span class="card-tag mono-font">#{tag}</span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- ══════════════════════════════════════════ -->
    <!-- LEBIU CLIENT SHOWCASE                       -->
    <!-- ══════════════════════════════════════════ -->
    <div class="lc-showcase reveal">

      <!-- Header row -->
      <div class="lc-header">
        <div class="lc-header-left">
          <div class="lc-eyebrow mono-font">
            <span class="lc-type-label">CLIENTE DE MINECRAFT</span>
            <span class="lc-badge-live mono-font">● LISTO</span>
          </div>
          <h3 class="lc-title pixel-font">Lebiu<span class="lc-accent">_</span>Client</h3>
          <p class="lc-subtitle">
            El cliente oficial de Lebiu Studio — acceso exclusivo, identidad propia y comunidad integrada.
            Construido desde cero para que cada sesión se sienta tuya.
          </p>
          <div class="lc-tags">
            {["launcher", "java", "desktop", "community", "fabric"].map(t => (
              <span class="lc-tag mono-font">#{t}</span>
            ))}
          </div>

          <!-- Download buttons -->
          <div class="lc-downloads">
            <a
              href="https://github.com/jhonatanlopezplay-art/lebiu-client-releases/releases/download/v8.0.8/Lebiu-Client-Setup-8.0.8.exe"
              class="lc-dl-btn lc-dl-windows mono-font"
              download
            >
              <svg class="lc-dl-icon" viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
                <path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.9-1.801"/>
              </svg>
              Windows
              <span class="lc-dl-ver">.exe — v8.0.8</span>
            </a>
            <a
              href="https://github.com/jhonatanlopezplay-art/lebiu-client-releases/releases/download/v8.0.8/lebiu-client_8.0.8_amd64.deb"
              class="lc-dl-btn lc-dl-linux mono-font"
              download
            >
              <svg class="lc-dl-icon" viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
                <path d="M12.504 0c-.155 0-.315.008-.48.021-4.226.333-3.105 4.807-3.17 6.298-.076 1.092-.3 1.953-1.05 3.02-.885 1.051-2.127 2.75-2.716 4.521-.278.832-.41 1.684-.287 2.489a.424.424 0 00-.11.135c-.26.268-.45.6-.663.839-.199.199-.485.267-.797.4-.313.136-.658.353-.814.74-.147.382-.088.695.06.971.15.275.375.52.625.74.775.639 1.245.787 1.29.863.44.864.525 1.504.55 1.96.024.459.005.757-.025 1.082-.03.316-.087.679-.045 1.07.04.395.186.714.41.892.23.18.455.24.73.25.37.007.71-.05.98-.25.27-.196.41-.5.42-.82.01-.325-.08-.67-.17-.988-.17-.648-.22-1.03-.1-1.456.078-.273.222-.512.367-.738.142-.226.274-.45.395-.696.142-.294.247-.615.34-.985.072-.282.15-.614.14-.921-.006-.14-.037-.258-.04-.396-.003-.13.022-.266.052-.4.056-.265.195-.582.338-.857a7.78 7.78 0 01.667-1.03c.282-.36.565-.68.79-.985.37-.502.584-1.02.63-1.603.078-.99-.085-2.17-.284-3.23-.2-1.06-.48-2.05-.65-2.96-.166-.91-.23-1.81-.13-2.54.06-.434.178-.829.424-1.092.246-.262.624-.41 1.117-.43.48-.02.902.14 1.163.42.26.28.366.68.37 1.13.008.87-.138 1.847-.29 2.826-.155.976-.33 1.95-.42 2.885-.09.938-.046 1.84.27 2.657.158.414.42.76.72 1.05.3.292.63.53.97.75.67.437 1.357.773 1.882 1.177.257.2.482.42.653.67.17.25.286.532.33.86.087.675-.16 1.45-.317 2.14-.155.69-.21 1.32-.013 1.775.19.447.59.737 1.14.82.26.04.54.04.8 0 .43-.073.798-.307.98-.64.185-.335.18-.71.1-1.05-.075-.36-.22-.695-.335-1.06-.23-.702-.383-1.48-.1-2.083.285-.602.9-1.06 1.507-1.443.61-.38 1.216-.712 1.64-1.115.43-.4.69-.87.73-1.43.065-.845-.28-1.876-.628-2.87-.35-.99-.72-1.95-.99-2.83-.274-.88-.45-1.68-.4-2.38.06-.7.35-1.32.79-1.77.44-.456 1.03-.73 1.72-.8.7-.07 1.36.1 1.87.44.505.33.83.83.93 1.39.09.55.02 1.15-.07 1.77-.178 1.235-.427 2.528-.488 3.75-.06 1.225.062 2.38.524 3.35.23.49.556.925.938 1.31.38.385.81.72 1.26 1.03.887.617 1.842 1.158 2.59 1.83.745.67 1.29 1.48 1.283 2.52-.004.56-.145 1.16-.338 1.76-.19.6-.42 1.198-.564 1.78-.14.58-.163 1.16.02 1.69.184.534.6.97 1.216 1.224.31.13.65.2 1 .2.35 0 .7-.07 1.01-.2.62-.257 1.04-.7 1.22-1.24.1