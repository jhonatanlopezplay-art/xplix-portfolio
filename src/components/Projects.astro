---
const mods = [
  {
    id: "minesweeper",
    name: "Buscaminas",
    type: "Fabric Mod",
    desc: "Minijuego de buscaminas donde la memoria juega un papel clave para no quedar eliminado. Inspirado en Squid Craft Games 4, totalmente competitivo.",
    tags: ["fabric", "minigame", "competitive"],
    icon: "",
    color: "#67e8f9",
    status: "released",
  },
  {
    id: "agrupados",
    name: "Agrupados",
    type: "Fabric Mod",
    desc: "Minijuego de grupos donde los jugadores deben agruparse antes que las salas se agoten. Muy estresante, especialmente al momento de jugarlo en vivo.",
    tags: ["fabric", "teams", "stress"],
    icon: "",
    color: "#fbbf24",
    status: "released",
  },
  {
    id: "periquito",
    name: "Periquito",
    type: "Fabric Mod",
    desc: "El famoso juego del periquito — la memoria lo hace tedioso de la mejor forma. Inspirado en los eventos de Eufonia Studio.",
    tags: ["fabric", "memory", "eufonia"],
    icon: "",
    color: "#34d399",
    status: "released",
  },
  {
    id: "galleta",
    name: "Galleta",
    type: "Fabric Mod",
    desc: "Un clásico que tenía que estar. Fue mi segundo proyecto y donde más avancé como desarrollador de mods — cada línea fue una lección.",
    tags: ["fabric", "classic", "challenge"],
    icon: "",
    color: "#a78bfa",
    status: "released",
  },
];

const launcher = {
  id: "lebiu-client",
  name: "Lebiu Client",
  type: "Cliente de Minecraft",
  desc: "Un cliente para nuestra comunidad con acceso a eventos exclusivos. Diseñado para que la experiencia de juego sea única desde el primer inicio.",
  tags: ["launcher", "java", "desktop", "community"],
  icon: "🐨",
  status: "wip",
};
---

<section id="projects" class="projects-section">
  <div class="container">

    <div class="reveal">
      <p class="section-badge mono-font">02 / projects</p>
      <h2 class="section-title pixel-font">mis_mods</h2>
      <div class="section-divider"></div>
    </div>

    <div class="project-sub-label reveal">
      <span class="mono-font">fabric_mods/</span>
      <span class="sub-desc mono-font">— Squid Craft Games 4 inspired</span>
    </div>

    <div class="mods-grid">
      {mods.map((mod) => (
        <div class="mod-card lg-card reveal" style={`--card-color: ${mod.color}`}>
          <div class="card-top-line"></div>
          <div class="card-header">
            <span class="card-icon">{mod.icon}</span>
            <span class={`card-status mono-font ${mod.status === 'released' ? 'status-live' : 'status-wip'}`}>
              {mod.status === 'released' ? '● LIVE' : '◌ WIP'}
            </span>
          </div>
          <p class="card-type mono-font">{mod.type}</p>
          <h3 class="card-name pixel-font">{mod.name}</h3>
          <p class="card-desc">{mod.desc}</p>
          <div class="card-tags">
            {mod.tags.map(tag => (
              <span class="card-tag mono-font">#{tag}</span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Launcher -->
    <div class="launcher-card lg-card reveal">
      <div class="launcher-inner">
        <div class="launcher-icon-wrap lg-card">
          <span>{launcher.icon}</span>
        </div>
        <div style="flex: 1">
          <p class="launcher-type mono-font">{launcher.type.toUpperCase()}</p>
          <h3 class="launcher-name pixel-font">{launcher.name}</h3>
          <p class="launcher-desc">{launcher.desc}</p>
          <div class="launcher-tags">
            {launcher.tags.map(tag => (
              <span class="launcher-tag lg mono-font">#{tag}</span>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="more-soon lg-card reveal">
      <span class="more-cursor">▮</span>
      <span class="mono-font"> más proyectos en camino...</span>
    </div>

  </div>
</section>

<style>
  .projects-section { padding: 6rem 0; position: relative; z-index: 1; }

  .project-sub-label {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    font-size: 0.75rem;
    color: var(--muted);
    letter-spacing: 1px;
  }
  .project-sub-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: rgba(255, 255, 255, 0.08);
    max-width: 200px;
  }
  .sub-desc { color: var(--muted); margin-left: 4px; }

  /* grid */
  .mods-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
    margin-bottom: 1rem;
  }

  /* card */
  .mod-card {
    padding: 1.75rem;
    cursor: default;
    transition: transform 0.25s, box-shadow 0.25s;
  }
  .mod-card:hover { transform: translateY(-6px); }

  .card-top-line {
    position: absolute;
    top: 0; left: 0; right: 0; height: 2px;
    background: var(--card-color, var(--cyan));
    opacity: 0; transition: opacity 0.2s;
    box-shadow: 0 0 16px var(--card-color, var(--cyan));
  }
  .mod-card:hover .card-top-line { opacity: 1; }

  .card-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.25rem; }
  .card-icon { font-size: 2rem; line-height: 1; }

  .card-status { font-size: 0.6rem; padding: 3px 8px; letter-spacing: 1px; }
  .status-live {
    color: var(--green);
    border: 1px solid rgba(52, 211, 153, 0.35);
    background: rgba(52, 211, 153, 0.08);
    text-shadow: 0 0 8px var(--green);
  }
  .status-wip {
    color: var(--amber);
    border: 1px solid rgba(251, 191, 36, 0.35);
    background: rgba(251, 191, 36, 0.08);
  }

  .card-type { font-size: 0.65rem; color: var(--muted); margin-bottom: 0.5rem; letter-spacing: 1px; }
  .card-name { font-size: 0.75rem; color: var(--white); margin-bottom: 1rem; line-height: 1.6; }
  .card-desc { font-size: 0.87rem; color: rgba(224, 242, 254, 0.65); line-height: 1.7; margin-bottom: 1.25rem; }

  .card-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .card-tag { font-size: 0.6rem; color: var(--muted2); padding: 2px 8px; }

  /* launcher */
  .launcher-card { padding: 2.5rem; margin-top: 2rem; position: relative; overflow: hidden; }
  .launcher-card::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; height: 2px;
    background: linear-gradient(90deg, var(--cyan), transparent);
    box-shadow: 0 0 20px var(--cyan);
  }
  .launcher-card::after {
    content: 'WIP';
    position: absolute; top: 1rem; right: 1rem;
    font-family: 'JetBrains Mono', monospace; font-size: 0.6rem;
    color: var(--amber);
    border: 1px solid rgba(251, 191, 36, 0.35);
    padding: 3px 8px;
    background: rgba(251, 191, 36, 0.08);
  }
  .launcher-inner { display: flex; gap: 2.5rem; align-items: flex-start; }
  .launcher-icon-wrap {
    width: 80px; height: 80px;
    display: flex; align-items: center; justify-content: center;
    font-size: 2.5rem; flex-shrink: 0;
  }
  .launcher-name { font-size: 0.8rem; color: var(--white); margin-bottom: 0.5rem; line-height: 1.6; }
  .launcher-type { font-size: 0.65rem; color: var(--cyan); margin-bottom: 1rem; letter-spacing: 1px; }
  .launcher-desc { font-size: 0.9rem; color: rgba(224, 242, 254, 0.65); line-height: 1.8; margin-bottom: 1.5rem; }
  .launcher-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .launcher-tag { font-size: 0.6rem; color: var(--cyan2); padding: 2px 8px; }

  /* more */
  .more-soon { margin-top: 3rem; padding: 2rem; text-align: center; font-size: 0.8rem; color: var(--muted); }
  .more-cursor { color: var(--cyan2); animation: blink 1s step-end infinite; text-shadow: 0 0 8px var(--cyan); }

  @media (max-width: 900px) {
    .launcher-inner { flex-direction: column; }
  }
</style>
