---
const mods = [
  {
    id: "minesweeper",
    name: "Buscaminas",
    type: "Fabric Mod",
    desc: "Minijuego de buscaminas aca es donde la memoria juega un papel muy importante para que no quedes eliminado. Inspirado en la temática de Squid Craft Games 4, competitivo.",
    tags: ["fabric", "minigame"],
    icon: "",
    color: "#ef4444",
    status: "released",
  },
  {
    id: "agrupados",
    name: "Agrupados",
    type: "Fabric Mod",
    desc: "Minijuego de grupos y equipos donde los jugadores deben agruparse antes que todas las salas se agoten, este minijuego es muy estresante sobre todo al momento de juagarlo.",
    tags: ["fabric", "minigame", "teams"],
    icon: "",
    color: "#f59e0b",
    status: "released",
  },
  {
    id: "periquito",
    name: "Periquito",
    type: "Fabric Mod",
    desc: "EL famosisimo juego del periquito lo increible de este juego es la memoria que la hace un poco tedioso. Inspirado en los eventos de Eufonia Studio.",
    tags: ["fabric", "memory", "minigame"],
    icon: "",
    color: "#10b981",
    status: "released",
  },
  {
    id: "galleta",
    name: "Galleta",
    type: "Fabric Mod",
    desc: "Un minijuego que obviamente debe de estar este fue mi segundo proyecto y fue en donde avanze mucho como desarrollador de mods.",
    tags: ["fabric", "chaos", "challenge"],
    icon: "",
    color: "#a78bfa",
    status: "released",
  },
];

const launcher = {
  id: "Cliente",
  name: "Lebiu CLient",
  type: "Cliente de Minecraft",
  desc: "Un cliente para nuestra comunidad este cliente de minecraft trae acceso a nuestro eventos.",
  tags: ["launcher", "java", "desktop"],
  icon: "🐨",
  color: "#06b6d4",
  status: "wip",
};
---

<section class="projects" id="projects">
  <div class="container">
    <div class="section-header">
      <span class="section-label mono-font">// 02</span>
      <h2 class="section-title pixel-font">projects</h2>
    </div>

    <!-- Mods label -->
    <div class="sub-section-label">
      <span class="mono-font sub-label">fabric_mods/</span>
      <span class="sub-desc mono-font">— Squid Craft Games 4 inspired</span>
    </div>

    <div class="mods-grid">
      {mods.map((mod) => (
        <div class="mod-card" data-color={mod.color}>
          <div class="card-top">
            <span class="mod-icon" style={`color: ${mod.color}`}>{mod.icon}</span>
            <span class={`mod-status ${mod.status === 'released' ? 'status-done' : 'status-wip'} mono-font`}>
              {mod.status === 'released' ? '● LIVE' : '◌ WIP'}
            </span>
          </div>
          <p class="mod-type mono-font">{mod.type}</p>
          <h3 class="mod-name pixel-font">{mod.name}</h3>
          <p class="mod-desc">{mod.desc}</p>
          <div class="mod-tags">
            {mod.tags.map(tag => (
              <span class="mod-tag mono-font">#{tag}</span>
            ))}
          </div>
          <div class="card-border-bottom" style={`background: ${mod.color}`}></div>
        </div>
      ))}
    </div>

    <!-- Launcher -->
    <div class="sub-section-label" style="margin-top: 3rem;">
      <span class="mono-font sub-label">launcher/</span>
      <span class="sub-desc mono-font">— in development</span>
    </div>

    <div class="launcher-card">
      <div class="launcher-left">
        <div class="launcher-icon-wrap">
          <span class="launcher-icon">{launcher.icon}</span>
        </div>
        <div>
          <p class="mod-type mono-font">{launcher.type}</p>
          <h3 class="mod-name pixel-font">{launcher.name}</h3>
        </div>
      </div>
      <p class="launcher-desc">{launcher.desc}</p>
      <div class="launcher-meta">
        <div class="mod-tags">
          {launcher.tags.map(tag => (
            <span class="mod-tag mono-font">#{tag}</span>
          ))}
        </div>
        <span class="status-wip mono-font">◌ EN DESARROLLO</span>
      </div>
    </div>

    <!-- More coming -->
    <div class="more-soon">
      <p class="more-text mono-font">
        <span class="blink-cursor">▮</span> más proyectos en camino...
      </p>
    </div>
  </div>
</section>

<style>
  .projects {
    padding: 6rem 0;
  }

  .section-label {
    font-size: 0.85rem;
    color: var(--cyan);
    display: block;
    margin-bottom: 0.5rem;
  }

  .section-title {
    font-size: clamp(1.2rem, 3vw, 1.8rem);
    color: var(--text);
    margin-bottom: 0;
    position: relative;
    display: inline-block;
  }

  .section-title::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 0;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, var(--purple), transparent);
  }

  .section-header {
    margin-bottom: 3rem;
  }

  .sub-section-label {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .sub-label {
    font-size: 0.9rem;
    color: var(--cyan);
  }

  .sub-desc {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .mods-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    margin-bottom: 1rem;
  }

  .mod-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 1.5rem;
    position: relative;
    overflow: hidden;
    transition: border-color 0.2s, background 0.2s, transform 0.15s;
    cursor: default;
  }

  .mod-card:hover {
    border-color: var(--border-purple);
    background: var(--bg-card-hover);
    transform: translateY(-3px);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .mod-icon {
    font-size: 1.8rem;
  }

  .mod-status {
    font-size: 0.6rem;
    padding: 3px 8px;
  }

  .status-done {
    color: var(--green);
    border: 1px solid var(--green);
    background: rgba(16, 185, 129, 0.08);
  }

  .status-wip {
    color: var(--amber);
    border: 1px solid var(--amber);
    background: rgba(245, 158, 11, 0.08);
  }

  .mod-type {
    font-size: 0.7rem;
    color: var(--text-muted);
    margin-bottom: 0.4rem;
  }

  .mod-name {
    font-size: 0.85rem;
    color: var(--text);
    margin-bottom: 0.75rem;
    line-height: 1.4;
  }

  .mod-desc {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .mod-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .mod-tag {
    font-size: 0.65rem;
    color: var(--text-muted);
    background: var(--bg);
    border: 1px solid var(--border);
    padding: 2px 8px;
  }

  .card-border-bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .mod-card:hover .card-border-bottom {
    opacity: 1;
  }

  /* Launcher card */
  .launcher-card {
    background: var(--bg-card);
    border: 1px solid var(--cyan-dim);
    padding: 2rem;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    gap: 1rem 2rem;
    align-items: start;
    transition: border-color 0.2s, background 0.2s;
    position: relative;
    overflow: hidden;
  }

  .launcher-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--cyan), transparent);
  }

  .launcher-card:hover {
    border-color: var(--cyan);
    background: var(--bg-card-hover);
  }

  .launcher-left {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .launcher-icon-wrap {
    width: 60px;
    height: 60px;
    background: rgba(6, 182, 212, 0.1);
    border: 2px solid var(--cyan-dim);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .launcher-icon {
    font-size: 2rem;
  }

  .launcher-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.7;
    grid-column: 2;
    grid-row: 1;
  }

  .launcher-meta {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .more-soon {
    margin-top: 3rem;
    text-align: center;
    padding: 2rem;
    border: 1px dashed var(--border);
  }

  .more-text {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .blink-cursor {
    color: var(--purple);
    animation: blink 1s step-end infinite;
  }

  @media (max-width: 768px) {
    .launcher-card {
      grid-template-columns: 1fr;
    }

    .launcher-desc {
      grid-column: 1;
      grid-row: 2;
    }

    .launcher-meta {
      grid-column: 1;
    }
  }
</style>
