---
---

<section class="section-glass" id="contact">
  <div class="container">
    <div class="section-glass-inner lg-card reveal">

      <div class="reveal">
        <p class="section-badge mono-font">03 / contact</p>
        <h2 class="section-title pixel-font">hablemos</h2>
        <div class="section-divider"></div>
      </div>

      <div class="contact-grid">
        <div class="reveal">
          <p class="contact-intro">
            ¿Tienes un proyecto en mente o quieres colaborar en un mod?
            Tengo comisiones abiertas — si quieres traer una idea genial al juego
            que te vio nacer, escríbeme.
          </p>

          <div class="contact-links">
            <a href="https://github.com/jhonatanlopezplay-art" class="contact-link lg-card" target="_blank" rel="noopener">
              <div class="link-icon-box mono-font">GH</div>
              <div>
                <p class="link-name mono-font">GitHub</p>
                <p class="link-desc">Xplix — código fuente</p>
              </div>
              <span class="link-arrow">→</span>
            </a>

            <a href="https://modrinth.com/user/Xplix" class="contact-link lg-card" target="_blank" rel="noopener">
              <div class="link-icon-box mono-font" style="color: var(--green)">MR</div>
              <div>
                <p class="link-name mono-font">Modrinth</p>
                <p class="link-desc">Mis mods publicados</p>
              </div>
              <span class="link-arrow">→</span>
            </a>

            <a href="https://discord.gg/FN2nVRDP5e" class="contact-link lg-card" target="_blank" rel="noopener">
              <div class="link-icon-box mono-font" style="color: #7289da">DC</div>
              <div>
                <p class="link-name mono-font">Discord</p>
                <p class="link-desc">Servidor donde trabajo</p>
              </div>
              <span class="link-arrow">→</span>
            </a>
          </div>
        </div>

        <div class="reveal">
          <div class="terminal lg-card">
            <div class="term-bar">
              <div class="term-dots">
                <div class="dot dot-r"></div>
                <div class="dot dot-y"></div>
                <div class="dot dot-g"></div>
              </div>
              <span class="term-label mono-font">xplix@portfolio ~ bash</span>
            </div>
            <div class="term-body mono-font">
              <div>
                <span class="t-prompt">~/portfolio</span>
                <span class="t-comment"> (main)</span>
                <span class="t-arrow"> ❯ </span>
                <span class="t-cmd">cat contact.json</span>
              </div>
              <div class="t-brace">{"{"}</div>
              <div>&nbsp;&nbsp;<span class="t-key">"alias"</span>: <span class="t-str">"Xplix"</span>,</div>
              <div>&nbsp;&nbsp;<span class="t-key">"role"</span>: <span class="t-str">"mod developer"</span>,</div>
              <div>&nbsp;&nbsp;<span class="t-key">"stack"</span>: [<span class="t-str">"Java"</span>, <span class="t-str">"Fabric"</span>],</div>
              <div>&nbsp;&nbsp;<span class="t-key">"status"</span>: <span class="t-val">open_for_collabs</span>,</div>
              <div>&nbsp;&nbsp;<span class="t-key">"commissions"</span>: <span class="t-val">true</span>,</div>
              <div>&nbsp;&nbsp;<span class="t-key">"vibe"</span>: <span class="t-str">"pixel art &amp; minigames"</span></div>
              <div class="t-brace">{"}"}</div>
              <div class="t-prompt-line">
                <span class="t-prompt">~/portfolio</span>
                <span class="t-comment"> (main)</span>
                <span class="t-arrow"> ❯ </span>
                <span class="t-cursor">█</span>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .section-glass { padding: 6rem 0; position: relative; z-index: 1; }
  .section-glass-inner { padding: 3.5rem 3rem; }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 5rem;
    align-items: start;
  }

  .contact-intro {
    font-size: 1rem;
    color: rgba(224, 242, 254, 0.7);
    line-height: 1.9;
    margin-bottom: 2.5rem;
  }

  .contact-links { display: flex; flex-direction: column; gap: 1rem; }

  .contact-link {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.2rem 1.5rem;
    color: var(--text);
    transition: all 0.2s;
    position: relative;
    overflow: hidden;
  }
  .contact-link:hover { transform: translateX(6px); color: var(--text); }

  .link-icon-box {
    width: 44px; height: 44px;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.75rem;
    color: var(--blue3);
    flex-shrink: 0;
  }
  .link-name { font-size: 0.85rem; color: var(--white); margin-bottom: 3px; }
  .link-desc  { font-size: 0.75rem; color: var(--muted); }
  .link-arrow {
    margin-left: auto;
    color: var(--muted);
    font-size: 1.2rem;
    transition: color 0.2s, text-shadow 0.2s;
  }
  .contact-link:hover .link-arrow {
    color: var(--cyan2);
    text-shadow: 0 0 10px var(--cyan);
  }

  /* Terminal */
  .terminal { overflow: hidden; }

  .term-bar {
    padding: 10px 16px;
    display: flex; align-items: center; gap: 10px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
  }
  .term-dots { display: flex; gap: 6px; }
  .dot { width: 10px; height: 10px; }
  .dot-r { background: #ef4444; }
  .dot-y { background: #f59e0b; }
  .dot-g { background: #10b981; }
  .term-label { font-size: 0.7rem; color: var(--muted); margin-left: auto; }

  .term-body {
    padding: 1.5rem 1.75rem;
    font-size: 0.8rem;
    line-height: 2.2;
  }
  .t-prompt  { color: var(--blue3); }
  .t-comment { color: var(--muted); }
  .t-arrow   { color: var(--cyan2); }
  .t-cmd     { color: var(--white); }
  .t-key     { color: var(--cyan2); }
  .t-val     { color: var(--blue2); }
  .t-str     { color: var(--amber); }
  .t-brace   { color: rgba(224, 242, 254, 0.35); padding: 0.4rem 0; display: block; }
  .t-cursor  {
    color: var(--cyan);
    animation: blink 1s step-end infinite;
    text-shadow: 0 0 8px var(--cyan);
  }
  .t-prompt-line { margin-top: 0.5rem; }

  @media (max-width: 900px) {
    .contact-grid { grid-template-columns: 1fr; gap: 3rem; }
    .section-glass-inner { padding: 2rem 1.5rem; }
  }
</style>
