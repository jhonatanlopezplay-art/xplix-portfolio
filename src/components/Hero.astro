---

<section class="hero" id="home">
  <div class="hero-inner container">

    <div class="hero-text">
      <div class="hero-chip lg mono-font">
        <span class="chip-dot"></span>
        available for collabs
      </div>

      <h1 class="hero-name pixel-font">
        <span class="x">X</span>plix<span class="cursor">▮</span>
      </h1>

      <div class="hero-tags">
        <span class="hero-tag lg mono-font">mod_developer</span>
        <span class="hero-tag lg mono-font">fabric_wizard</span>
        <span class="hero-tag lg mono-font">pixel_enjoyer</span>
        <span class="hero-tag lg mono-font">minigame_creator</span>
      </div>

      <p class="hero-sub">
        Desarrollador de mods para <strong>Fabric</strong> · Creador de minijuegos<br />
        Fan del <strong>pixel art</strong> y las noches frente al monitor.
      </p>

      <div class="hero-cta">
        <a href="#projects" class="btn-primary lg pixel-font">ver proyectos</a>
        <a href="#contact" class="btn-ghost mono-font">// contacto →</a>
      </div>
    </div>

    <div class="hero-avatar">
      <div class="avatar-container">
        <div class="avatar-ring"></div>
        <div class="avatar-ring-2"></div>
        <div class="avatar-img-wrap">
          <img src="/perfil.png" alt="Xplix avatar" class="avatar-img" />
        </div>
        <div class="avatar-float-tag tag-1 lg mono-font">🧩 fabric_wizard</div>
        <div class="avatar-float-tag tag-2 lg mono-font">☕ java_dev</div>
        <div class="avatar-float-tag tag-3 lg mono-font">🎮 minigames</div>
      </div>
    </div>

  </div>
  <div class="scroll-hint mono-font">scroll_down ↓</div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 100px 0 5rem;
    position: relative;
    z-index: 1;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: 4rem;
    align-items: center;
  }

  /* chip */
  .hero-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 16px;
    margin-bottom: 2rem;
    font-size: 0.7rem;
    color: var(--cyan2);
    letter-spacing: 1px;
    opacity: 0;
    animation: slideIn 0.6s ease 0.2s forwards;
  }
  .chip-dot {
    width: 8px; height: 8px;
    background: var(--green);
    display: block;
    animation: blink 1.5s step-end infinite;
    box-shadow: 0 0 8px var(--green);
  }

  /* name */
  .hero-name {
    font-size: clamp(2.2rem, 4vw, 3.8rem);
    line-height: 1.4;
    color: var(--white);
    margin-bottom: 1.5rem;
    opacity: 0;
    animation: slideIn 0.6s ease 0.4s forwards;
    text-shadow: 0 0 40px rgba(125, 211, 252, 0.5), 0 0 80px rgba(14, 165, 233, 0.25);
  }
  .x {
    color: var(--cyan);
    text-shadow: 0 0 30px rgba(34, 211, 238, 0.9), 0 0 60px rgba(34, 211, 238, 0.4);
  }
  .cursor {
    font-size: 0.6em;
    color: var(--blue2);
    animation: blink 1s step-end infinite;
  }

  /* tags */
  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 2.5rem;
    opacity: 0;
    animation: slideIn 0.6s ease 0.8s forwards;
  }
  .hero-tag {
    font-size: 0.7rem;
    padding: 6px 14px;
    color: var(--cyan2);
    letter-spacing: 0.5px;
  }

  /* sub */
  .hero-sub {
    font-size: 1.05rem;
    color: rgba(224, 242, 254, 0.7);
    line-height: 1.9;
    max-width: 540px;
    margin-bottom: 2.5rem;
    opacity: 0;
    animation: slideIn 0.6s ease 0.6s forwards;
  }
  .hero-sub strong { color: var(--cyan2); font-weight: 700; }

  /* cta */
  .hero-cta {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    flex-wrap: wrap;
    opacity: 0;
    animation: slideIn 0.6s ease 1s forwards;
  }
  .btn-primary {
    font-size: 0.55rem;
    padding: 16px 28px;
    color: var(--white);
    border: 1.5px solid rgba(103, 232, 249, 0.5);
    letter-spacing: 1px;
    display: inline-block;
    transition: all 0.2s;
    position: relative;
    overflow: hidden;
    text-shadow: 0 0 10px rgba(103, 232, 249, 0.5);
  }
  .btn-primary:hover {
    box-shadow: 0 0 40px rgba(14, 165, 233, 0.4), 6px 6px 0 rgba(14, 165, 233, 0.15);
    transform: translate(-3px, -3px);
    color: white;
    border-color: var(--cyan2);
  }
  .btn-ghost {
    font-size: 0.85rem;
    color: rgba(224, 242, 254, 0.55);
    transition: color 0.2s, text-shadow 0.2s;
    letter-spacing: 1px;
  }
  .btn-ghost:hover {
    color: var(--cyan2);
    text-shadow: 0 0 10px rgba(103, 232, 249, 0.6);
  }

  /* avatar */
  .hero-avatar {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    opacity: 0;
    animation: slideIn 0.8s ease 0.5s forwards;
  }
  .avatar-container { position: relative; width: 340px; height: 340px; }

  .avatar-ring {
    position: absolute; inset: 0; border-radius: 50%;
    border: 1.5px solid rgba(14, 165, 233, 0.35);
    animation: rotate-ring 12s linear infinite;
    box-shadow: 0 0 20px rgba(14, 165, 233, 0.15);
  }
  .avatar-ring::before {
    content: '';
    position: absolute; top: -5px; left: 50%; transform: translateX(-50%);
    width: 10px; height: 10px; background: var(--cyan2); border-radius: 50%;
    box-shadow: 0 0 16px var(--cyan2), 0 0 32px var(--cyan);
  }
  .avatar-ring-2 {
    position: absolute; inset: 18px; border-radius: 50%;
    border: 1px dashed rgba(14, 165, 233, 0.18);
    animation: rotate-ring 22s linear infinite reverse;
  }
  .avatar-img-wrap {
    position: absolute; inset: 34px; border-radius: 50%; overflow: hidden;
    border: 2.5px solid rgba(56, 189, 248, 0.7);
    box-shadow:
      0 0 60px rgba(14, 165, 233, 0.7),
      0 0 120px rgba(14, 165, 233, 0.25),
      inset 0 0 30px rgba(14, 165, 233, 0.15);
  }
  .avatar-img {
    width: 100%; height: 100%;
    object-fit: cover;
    image-rendering: pixelated;
  }

  .avatar-float-tag {
    position: absolute;
    font-size: 0.68rem;
    padding: 7px 13px;
    color: var(--cyan2);
    white-space: nowrap;
  }
  .tag-1 { top: 20px; right: -40px; animation: float 4s ease infinite; }
  .tag-2 { bottom: 40px; left: -50px; animation: float 4s ease 2s infinite; }
  .tag-3 { top: 50%; right: -60px; animation: float 4s ease 1s infinite; }

  /* scroll hint */
  .scroll-hint {
    position: absolute;
    bottom: 2rem; left: 50%; transform: translateX(-50%);
    font-size: 0.7rem;
    color: rgba(224, 242, 254, 0.4);
    letter-spacing: 2px;
    animation: blink 2.5s step-end infinite;
  }

  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; gap: 3rem; }
    .hero-avatar { order: -1; }
  }
  @media (max-width: 600px) {
    .hero-name { font-size: 1.8rem; }
    .avatar-container { width: 260px; height: 260px; }
    .avatar-float-tag { display: none; }
  }
</style>
