<nav class="nav">
  <div class="nav-inner container">
    <span class="nav-logo pixel-font">
      <span class="logo-bracket">[</span>Xplix<span class="logo-bracket">]</span>
    </span>
    <ul class="nav-links">
      <li><a href="#about" class="nav-link mono-font">// about</a></li>
      <li><a href="#projects" class="nav-link mono-font">// projects</a></li>
      <li><a href="#contact" class="nav-link mono-font">// contact</a></li>
    </ul>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(10, 10, 15, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
  }

  .nav-logo {
    font-size: 0.65rem;
    color: var(--purple-light);
    letter-spacing: 1px;
    cursor: default;
  }

  .logo-bracket {
    color: var(--cyan);
  }

  .nav-links {
    display: flex;
    gap: 2rem;
    list-style: none;
  }

  .nav-link {
    font-size: 0.85rem;
    color: var(--text-muted);
    transition: color 0.2s;
    position: relative;
  }

  .nav-link:hover {
    color: var(--purple-light);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--purple);
    transform: scaleX(0);
    transition: transform 0.2s;
    image-rendering: pixelated;
  }

  .nav-link:hover::after {
    transform: scaleX(1);
  }

  @media (max-width: 600px) {
    .nav-links {
      gap: 1rem;
    }
    .nav-link {
      font-size: 0.75rem;
    }
  }
</style>
