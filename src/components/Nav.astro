---
---

<nav>
  <div class="lg nav-glass"></div>
  <div class="nav-inner container">
    <div class="nav-logo pixel-font">
      <span class="bracket">[</span>Xplix<span class="bracket">]</span>
    </div>
    <ul class="nav-links">
      <li><a href="#about" class="mono-font"><span class="nav-dot"></span>about</a></li>
      <li><a href="#projects" class="mono-font"><span class="nav-dot"></span>projects</a></li>
      <li><a href="#contact" class="mono-font"><span class="nav-dot"></span>contact</a></li>
    </ul>
  </div>
</nav>

<style>
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    height: 64px;
    display: flex;
    align-items: center;
  }

  .nav-glass {
    position: absolute;
    inset: 0;
    border-top: none;
    border-left: none;
    border-right: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12) !important;
    backdrop-filter: blur(30px) saturate(2) brightness(1.1) !important;
    -webkit-backdrop-filter: blur(30px) saturate(2) brightness(1.1) !important;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    z-index: 1;
  }

  .nav-logo {
    font-size: 0.6rem;
    color: var(--blue3);
    letter-spacing: 2px;
    text-shadow: 0 0 20px rgba(125, 211, 252, 0.7);
  }

  .bracket { color: var(--cyan2); }

  .nav-links {
    display: flex;
    gap: 2rem;
    list-style: none;
  }

  .nav-links a {
    font-size: 0.78rem;
    color: rgba(224, 242, 254, 0.65);
    transition: color 0.2s, text-shadow 0.2s;
    letter-spacing: 1px;
  }

  .nav-links a:hover {
    color: var(--cyan2);
    text-shadow: 0 0 12px rgba(103, 232, 249, 0.8);
  }

  .nav-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    background: var(--cyan);
    margin-right: 6px;
    animation: blink 2s step-end infinite;
    vertical-align: middle;
  }

  @media (max-width: 600px) {
    .nav-links { gap: 1rem; }
    .nav-links a { font-size: 0.7rem; }
  }
</style>
