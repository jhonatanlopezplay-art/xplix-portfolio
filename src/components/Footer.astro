---
---

<footer class="lg">
  <div class="footer-inner container">
    <div class="footer-logo pixel-font">
      <span class="bracket">[</span>Xplix<span class="bracket">]</span>
    </div>
    <p class="footer-text mono-font">
      built with ♥ &amp; <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>
      · pixel art life · 2024
    </p>
    <p class="footer-year mono-font">Mod developer &amp; pixel enjoyer</p>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 2.5rem 0;
    position: relative;
    z-index: 1;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-logo {
    font-size: 0.55rem;
    color: var(--blue3);
    text-shadow: 0 0 15px rgba(125, 211, 252, 0.5);
  }
  .bracket { color: var(--cyan2); }

  .footer-text {
    font-size: 0.75rem;
    color: var(--muted);
  }
  .footer-text a {
    color: var(--cyan2);
    text-decoration: none;
    transition: text-shadow 0.2s;
  }
  .footer-text a:hover { text-shadow: 0 0 8px var(--cyan); }

  .footer-year {
    font-size: 0.7rem;
    color: var(--muted);
  }

  @media (max-width: 600px) {
    .footer-inner { flex-direction: column; text-align: center; }
  }
</style>
